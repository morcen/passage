<?php

namespace {{ namespace }};

use Illuminate\Http\Request;
use Morcen\Passage\PassageHandler;

class {{ class }} extends PassageHandler
{
    public function getOptions(): array
    {
        return [
            'base_uri' => 'https://api.example.com/',
        ];
    }

    public function getRequest(Request $request): Request
    {
        // Inject an API key header. Change 'X-API-Key' to the header your service expects.
        return $this->withApiKey($request, config('services.example.key'), 'X-API-Key');
    }
}
